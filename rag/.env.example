# Copy this file to rag/.env and fill in your own keys.
# Do not commit rag/.env. Do not add quotes or spaces around the values.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional. Portrait, voice, and recitation video use Alibaba DashScope.
DASHSCOPE_API_KEY=
